# Copy to .env and adjust if needed. Defaults are fine for local/dev use.

# --- Postgres (OLTP source) ---
POSTGRES_DB=worldbank
POSTGRES_USER=wb_app
POSTGRES_PASSWORD=wb_app_pw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- ClickHouse (OLAP target) ---
CLICKHOUSE_DB=worldbank
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_pw
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# --- Kafka / Kafka Connect (Debezium CDC) ---
KAFKA_BROKER=kafka:9092
KAFKA_CONNECT_URL=http://kafka-connect:8083

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# --- World Bank API ---
WORLD_BANK_BASE_URL=https://api.worldbank.org/v2
WORLD_BANK_COUNTRIES=RW,KE,ET,SS,TD
# Indicators: GDP growth, unemployment, poverty headcount, account ownership (financial inclusion)
WORLD_BANK_INDICATORS=NY.GDP.MKTP.KD.ZG,SL.UEM.TOTL.ZS,SI.POV.NAHC,FX.OWN.TOTL.ZS

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
