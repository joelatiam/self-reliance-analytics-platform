# Copy to .env and adjust if needed. Defaults are fine for local/dev use.

# --- Postgres (OLTP source) ---
POSTGRES_DB=self_reliance
POSTGRES_USER=sr_app
POSTGRES_PASSWORD=sr_app_pw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- ClickHouse (OLAP target) ---
# CLICKHOUSE_DB must match the database name in apps/warehouse/init/*.sql,
# which ClickHouse runs verbatim on first boot; change both together.
CLICKHOUSE_DB=self_reliance
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_pw
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123

# --- Kafka / Kafka Connect (Debezium CDC) ---
# The broker address is fixed at kafka:9092 inside the compose network and is
# baked into apps/warehouse/init/01_kafka_sources.sql, so it is not a knob.
KAFKA_CONNECT_URL=http://kafka-connect:8083

# --- Airflow ---
# The executor is pinned to SequentialExecutor in docker-compose.yml (single
# scheduler, SQLite metadata DB); it is deliberately not configurable here.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# --- World Bank API ---
WORLD_BANK_BASE_URL=https://api.worldbank.org/v2
WORLD_BANK_COUNTRIES=RW,KE,ET,SS,TD
# Indicators: GDP growth, unemployment, poverty headcount, account ownership (financial inclusion)
WORLD_BANK_INDICATORS=NY.GDP.MKTP.KD.ZG,SL.UEM.TOTL.ZS,SI.POV.NAHC,FX.OWN.TOTL.ZS

# --- UNHCR Refugee Population Statistics API ---
UNHCR_BASE_URL=https://api.unhcr.org/population/v1/population
UNHCR_COUNTRIES=RWA,KEN,ETH,SSD,TCD
UNHCR_YEAR_FROM=2015
UNHCR_YEAR_TO=2023

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Metabase (optional BI layer, `bi` profile only) ---
# Not started by `docker compose up`. See apps/bi/README.md.
METABASE_PORT=3001

# --- Clients API (simulated source system) ---
CLIENTS_API_DB_NAME=self_reliance_ops
CLIENTS_API_DB_USER=sr_app
CLIENTS_API_DB_PASSWORD=sr_app_pw
# Base URL the pipeline pulls from
CLIENTS_API_BASE_URL=http://clients-api:4000/api/v1
# Leave empty to disable API-key auth (default for local runs)
CLIENTS_API_KEY=
CLIENTS_API_PAGE_SIZE=500
# live = unbounded generation; test = every generation run capped at 100 rows
SIMULATION_MODE=live
SIMULATION_COUNTRIES=RWA,KEN,ETH,SSD,TCD
SIMULATION_SEED_ON_BOOT=true
SIMULATION_SEED_CLIENTS=250
SIMULATION_CRON_ENABLED=true
