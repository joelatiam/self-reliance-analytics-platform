# Copy to .env when running the API outside docker compose.

NODE_ENV=development
APP_PORT=4000
API_PREFIX=api
# Shared key expected in the x-api-key header; empty disables auth
API_KEY=

DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_NAME=self_reliance_ops
DATABASE_USERNAME=sr_app
DATABASE_PASSWORD=sr_app_pw
DATABASE_LOGGING=false

# live = unbounded generation; test = every generation run capped at 100 rows
SIMULATION_MODE=live
SIMULATION_COUNTRIES=RWA,KEN,ETH,SSD,TCD
SIMULATION_SEED_ON_BOOT=true
SIMULATION_SEED_CLIENTS=250
SIMULATION_CRON_ENABLED=true
# Set for reproducible data; leave empty for fresh randomness each boot
SIMULATION_SEED=

# Per-tick volumes, as "min:max"
SIMULATION_NEW_CLIENTS=1:5
SIMULATION_LOAN_APPS=1:6
SIMULATION_REPAYMENTS=3:14
SIMULATION_ADVISORY=2:10
SIMULATION_METRICS=2:12
# Share of installments paid on time, and share of late loans that default
SIMULATION_ON_TIME_RATE=0.93
SIMULATION_DEFAULT_RATE=0.04
