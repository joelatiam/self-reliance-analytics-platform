{
  "uid": "wb-pipeline-overview",
  "title": "World Bank Pipeline Overview",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "CDC Lag (rows)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "wb_pipeline_cdc_lag_rows", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "CDC Lag (seconds since last event)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "wb_pipeline_cdc_lag_seconds", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 300 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Pipeline Scrape Success",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "wb_pipeline_scrape_success", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "OK", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Row Counts: Postgres vs ClickHouse",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 18, "x": 0, "y": 6 },
      "targets": [
        { "expr": "wb_pipeline_postgres_observations_total", "legendFormat": "postgres", "refId": "A" },
        { "expr": "wb_pipeline_clickhouse_observations_total", "legendFormat": "clickhouse", "refId": "B" }
      ]
    }
  ]
}
