{
  "uid": "self-reliance-pipeline-overview",
  "title": "Pipeline Overview",
  "schemaVersion": 39,
  "version": 2,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "CDC Lag (rows)",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sr_pipeline_cdc_lag_rows",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "noValue": "N/A"
        }
      }
    },
    {
      "id": 2,
      "title": "CDC Lag (seconds since last event)",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "sr_pipeline_cdc_lag_seconds",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "noValue": "N/A"
        }
      }
    },
    {
      "id": 3,
      "title": "Pipeline Scrape Success",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sr_pipeline_scrape_success",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "OK",
                  "color": "green"
                }
              }
            }
          ],
          "noValue": "N/A"
        }
      }
    },
    {
      "id": 4,
      "title": "Row Counts: Postgres vs ClickHouse",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "sr_pipeline_postgres_observations_total",
          "legendFormat": "postgres",
          "refId": "A"
        },
        {
          "expr": "sr_pipeline_clickhouse_observations_total",
          "legendFormat": "clickhouse",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "CDC Lag by Table (rows behind Postgres)",
      "description": "Per-table backlog. The headline CDC lag stat only watches observations, so a single stalled topic is only visible here.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "sr_pipeline_cdc_lag_rows_by_table",
          "legendFormat": "{{table}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Ingestion Watermark Age (seconds)",
      "description": "Seconds since each clients API resource last advanced its watermark. Climbing past ~600s means the ten-minute pull has stopped making progress.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "sr_pipeline_ingestion_watermark_age_seconds",
          "legendFormat": "{{resource}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Replicated Rows: Postgres vs ClickHouse (all tables)",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "expr": "sr_pipeline_postgres_rows_total",
          "legendFormat": "postgres {{table}}",
          "refId": "A"
        },
        {
          "expr": "sr_pipeline_clickhouse_rows_total",
          "legendFormat": "clickhouse {{table}}",
          "refId": "B"
        }
      ]
    }
  ]
}
